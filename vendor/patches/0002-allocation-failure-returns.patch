accudist patch 0002: allocation failure returns instead of exit(1).
With MATHLIB_ERROR no longer exiting, every call site must return; callers of the
void w_init_maybe() helpers check the cache pointer and return NaN.

--- a/src/bessel_i.c	2026-09-07 08:18:08
+++ b/src/bessel_i.c	2026-09-07 08:19:42
@@ -66,7 +66,7 @@
     alpha -= (double)(nb-1);
 #ifdef MATHLIB_STANDALONE
     bi = (double *) calloc(nb, sizeof(double));
-    if (!bi) MATHLIB_ERROR("%s", _("bessel_i allocation error"));
+    if (!bi) { MATHLIB_ERROR("%s", _("bessel_i allocation error")); return ML_NAN; }
 #else
     vmax = vmaxget();
     bi = (double *) R_alloc((size_t) nb, sizeof(double));
